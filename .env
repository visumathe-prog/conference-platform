# .env.example - fill with real keys

# Stripe (Payments)
STRIPE_SECRET_KEY=sk_live_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PUBLISHABLE_KEY=pk_live_

# SendGrid (Emails)
SENDGRID_API_KEY=SG.
SENDGRID_FROM_EMAIL=noreply@conference.com

# AWS (S3, SNS, SQS, Lambda)
AWS_ACCESS_KEY_ID=AKIA
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
AWS_S3_BUCKET=conference-certificates
AWS_SNS_TOPIC_ARN=arn:aws:sns:
AWS_SQS_QUEUE_URL=https://sqs.

# Azure (Alternative cloud)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=
AZURE_SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://
AZURE_FUNCTION_KEY=

# Databases
POSTGRES_CONNECTION_STRING=Host=localhost;Database=conference;Username=postgres;Password=
MONGO_CONNECTION_STRING=mongodb://localhost:27017
REDIS_CONNECTION_STRING=localhost:6379,password=
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_secure_password
REDIS_PASSWORD=your_redis_password

# Message Brokers
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
RABBITMQ_CONNECTION_STRING=amqp://guest:guest@localhost:5672

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-key-at-least-32-characters-long
JWT_ISSUER=conference-platform
JWT_AUDIENCE=conference-api

# API Gateway
YARP_REVERSE_PROXY_CONFIG=./reverse-proxy.json

# Monitoring
PROMETHEUS_ENABLED=true
GRAFANA_API_KEY=

# AI Tool (External REST API)
AI_TOOL_API_URL=https://api.ai-tool.com/v1
AI_TOOL_API_KEY=

# Docker environment
DOCKER_ENV=development
