{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Information",
      "Yarp": "Debug"
    }
  },
  "ReverseProxy": {
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "event-cluster": {
        "Destinations": {
          "event": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "payment": {
            "Address": "http://localhost:5003"
          }
        }
      },
      "certificate-cluster": {
        "Destinations": {
          "certificate": {
            "Address": "http://localhost:5004"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification": {
            "Address": "http://localhost:5005"
          }
        }
      },
      "analytics-cluster": {
        "Destinations": {
          "analytics": {
            "Address": "http://localhost:5006"
          }
        }
      }
    }
