{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Yarp": "Information"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/auth/{**catch-all}" }
        ]
      },
      "users-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/users/{**catch-all}" }
        ]
      },
      "events-route": {
        "ClusterId": "event-cluster",
        "Match": {
          "Path": "/api/events/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/events/{**catch-all}" }
        ]
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/payment/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/payment/{**catch-all}" }
        ]
      },
      "certificate-route": {
        "ClusterId": "certificate-cluster",
        "Match": {
          "Path": "/api/certificate/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/certificate/{**catch-all}" }
        ]
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/api/notification/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/notification/{**catch-all}" }
        ]
      },
      "analytics-route": {
        "ClusterId": "analytics-cluster",
        "Match": {
          "Path": "/api/analytics/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/analytics/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity": {
            "Address": "http://identity-service:80"
          }
        }
      },
      "event-cluster": {
        "Destinations": {
          "event": {
            "Address": "http://event-service:80"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "payment": {
            "Address": "http://payment-service:80"
          }
        }
      },
      "certificate-cluster": {
        "Destinations": {
          "certificate": {
            "Address": "http://certificate-service:80"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification": {
            "Address": "http://notification-service:80"
          }
        }
      },
      "analytics-cluster": {
        "Destinations": {
          "analytics": {
            "Address": "http://analytics-service:80"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
